# Logging. LOG_LEVEL sets the root Python log level for the backend, workers,
# and MCP. SQLALCHEMY_LOG_LEVEL is pinned separately so raising LOG_LEVEL to
# INFO or DEBUG does not flood the log with every SQL statement.
LOG_LEVEL=INFO
SQLALCHEMY_LOG_LEVEL=WARNING

# Database (docker-compose sets this automatically; override for external DB)
# The backend refuses to start if DATABASE_URL still contains this placeholder
# password (B-03) — replace it before running anything against real data.
DB_PASSWORD=change_me_secure_password
# Host-side backend development reads these from .env. Docker Compose overrides
# them with in-network service URLs for containerized backend/worker services.
DATABASE_URL=postgresql+asyncpg://palaceoftruth:change_me_secure_password@localhost:5432/palaceoftruth
# Production must add ?sslmode=verify-full and point this at the database CA.
DATABASE_SSL_ROOT_CERT=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
REDIS_URL=redis://localhost:6379
# F-06: docker-compose.yml's redis service requires this (requirepass) so a
# plain `docker compose up` never ships an unauthenticated queue. Kept out of
# REDIS_URL, same reasoning as DB_PASSWORD/DATABASE_URL above.
REDIS_PASSWORD=change_me_redis_password
# Leave REDIS_SENTINEL_HOSTS empty for a single-node Redis: the backend and
# worker then skip the Sentinel startup gate entirely. When it is set, both wait
# for Sentinel to report a writable primary before they open an ARQ pool, so a
# Sentinel election during rollout no longer kills startup.
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_MASTER=mymaster
REDIS_SENTINEL_STARTUP_TIMEOUT_SECONDS=180

# OpenAI (embeddings + transcription only)
OPENAI_API_KEY=sk-...

# OpenRouter (LLM — chat, summarization, tagging)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_DEFAULT_MODEL=minimax/minimax-m2.7
CLIENT_LLM_ALLOWED_MODELS=
TENANT_LLM_MAX_CONCURRENT_REQUESTS=2
TENANT_LLM_DAILY_TOKEN_LIMIT=250000
MEDIA_TENANT_ARTIFACT_QUOTA_BYTES=2147483648
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b
OPENROUTER_VISION_MODEL=minimax/minimax-m3
OPENROUTER_VISION_FALLBACK_MODELS=openai/gpt-4o-mini,openai/gpt-4.1-mini
RELATIONSHIP_CLASSIFICATION_MODEL=openai/gpt-4.1
RELATIONSHIP_CLASSIFICATION_TEMPERATURE=0.0
RELATIONSHIP_CLASSIFICATION_SEED=1083
RELATIONSHIP_EXTRACTION_MIN_CONFIDENCE=0.7
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
GITHUB_PAT=
PALACEOFTRUTH_SYNC_SOURCE_CREDENTIAL_KEY=

# API Auth. Generate a strong random key, e.g. `openssl rand -hex 32` — the
# backend refuses to start with this placeholder left in place (M-05/B-03).
API_KEY=
# Pepper for stored credential verifiers (API keys, OAuth client secrets and
# tokens, pairing keys, browser sessions). Blank keeps the legacy unsalted
# SHA-256 format; DEPLOYMENT_CLUSTER-bearing (real cluster) deployments now
# refuse to start without it (A-05). Generate with `openssl rand -hex 32`.
# Stored hashes are read in both formats and re-hashed on next use, so setting
# this is safe on a running deployment. Changing it later invalidates every
# credential already hashed with the previous value.
CREDENTIAL_PEPPER=
# Optional (D-08). ISO-8601 timestamp; once past, a credential still stored in
# the legacy unpeppered format is rejected instead of accepted-and-upgraded.
# Set this only after CREDENTIAL_PEPPER has been live long enough for active
# credentials to have re-authenticated at least once.
CREDENTIAL_LEGACY_HASH_CUTOFF_AT=
API_KEY_TTL_DAYS=90
EXPOSE_API_DOCS=true
CORS_ALLOWED_ORIGINS=https://palaceoftruth.test,http://localhost:3000
TRUSTED_HOSTS=palaceoftruth.test,api.palaceoftruth.test,mcp.palaceoftruth.test,localhost,127.0.0.1
ADMIN_ALLOWED_HOSTS=admin.palaceoftruth.test,localhost,127.0.0.1

# Browser sign-in sessions for the SPA. The tenant API key is exchanged once
# for an HttpOnly cookie, so nothing readable by page scripts stays behind.
# Keep BROWSER_SESSION_COOKIE_SECURE true unless the deployment knowingly
# serves the UI over plain HTTP: browsers treat http://localhost as secure
# already, so local development needs no exception.
BROWSER_SESSION_TTL_SECONDS=2592000
ELEVATED_BROWSER_SESSION_TTL_SECONDS=2592000
BROWSER_SESSION_MAX_PER_TENANT=20
BROWSER_SESSION_COOKIE_SECURE=true
# Backend refuses to start with this placeholder left in place (B-03).
PALACEOFTRUTH_ADMIN_SECRET=change_me_admin_secret

# Optional remote MCP OAuth client_credentials auth. Register the client through
# /api/v1/admin/tenants/{tenant_id}/mcp-clients/register and store the one-time
# client_secret outside git.
PALACEOFTRUTH_MCP_CLIENT_KEY=codex-local
PALACEOFTRUTH_MCP_CLIENT_NAME=Palace local MCP
PALACEOFTRUTH_MCP_CLIENT_SCOPES=read,write
PALACEOFTRUTH_MCP_OAUTH_CLIENT_SECRET=
PALACEOFTRUTH_MCP_BEARER_TOKEN=
PALACEOFTRUTH_MCP_OAUTH_TOKEN_URL=

# Optional frontend dev override. Host-run Vite will auto-detect a healthy backend,
# but you can pin it here if you want a specific target.
VITE_API_PROXY_TARGET=https://api.palaceoftruth.test

# The Vite dev proxy verifies the target's TLS certificate. Set this only for the
# local `.test` stack, whose certificate Node does not trust. Never set it when
# the proxy target is staging or production.
# VITE_DEV_PROXY_ALLOW_INSECURE_TLS=1

# Optional tuning (these match the defaults in config.py — only set to override)
RETRIEVAL_CAPTURE_ALLOW_RAW_QUERIES=false
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_PROFILE_NAME=openai-text-embedding-3-small-1536
EMBEDDING_EXPERIMENTAL_PROFILES_ENABLED=false
# Optional TEI-compatible local HTTP embedding provider. Keep OpenAI defaults
# unless you have a 1536-dimensional local server and fresh embeddings planned.
EMBEDDING_LOCAL_HTTP_URL=
EMBEDDING_LOCAL_HTTP_PATH=/embed
EMBEDDING_LOCAL_HTTP_API_KEY=
EMBEDDING_LOCAL_HTTP_TIMEOUT_SECONDS=30
EMBEDDING_LOCAL_HTTP_NORMALIZE=true
EMBEDDING_LOCAL_HTTP_TRUNCATE=true
WHISPER_MODEL=gpt-4o-transcribe-diarize
TRANSCRIPTION_PROVIDER=openai
# Set TRANSCRIPTION_PROVIDER=local_whisperx to use the OpenAI-compatible
# llm-gateway transcription endpoint instead of OpenAI/AssemblyAI.
LLM_GATEWAY_URL=http://llm-gateway.example:8080
LLM_GATEWAY_TOKEN=
LOCAL_WHISPERX_MODEL=whisperx/base
# When a non-OpenAI provider fails terminally (unavailable, or transient
# failures exhausted), retry the chunk on OpenAI instead of failing the job.
# Set false to guarantee audio never leaves the configured provider.
TRANSCRIPTION_FALLBACK_TO_OPENAI=true
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_SPEECH_MODEL=universal-2
ASSEMBLYAI_POLL_INTERVAL_SECONDS=2.0
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=1500
MEDIA_FFMPEG_TIMEOUT_SECONDS=300
TRANSCRIPTION_MAX_CHUNK_SECONDS=600
TRANSCRIPTION_REQUEST_TIMEOUT_SECONDS=300
# Connect is budgeted separately: a dropped link blackholes the SYN, so sharing
# the read budget above would stall a job instead of retrying/falling back.
TRANSCRIPTION_CONNECT_TIMEOUT_SECONDS=10.0
TRANSCRIPTION_TRANSIENT_RETRIES=2
TRANSCRIPTION_RETRY_BACKOFF_SECONDS=2.0
# Ceiling on the exponential backoff (backoff * 2**attempt).
TRANSCRIPTION_RETRY_MAX_DELAY_SECONDS=60.0
TRANSCRIPTION_MAX_PARALLEL_CHUNKS=2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEARCH_LIMIT=10
UPLOAD_ARTIFACT_DIR=/tmp/palaceoftruth/upload-artifacts
APP_VERSION=local
RETRIEVAL_CAPTURE_ENABLED=false
RETRIEVAL_CAPTURE_PATH=/tmp/palaceoftruth/retrieval-capture.ndjson
# fingerprint stores no raw query text. redacted stores token lengths. raw is for explicit local debugging only.
RETRIEVAL_CAPTURE_QUERY_MODE=fingerprint
RETRIEVAL_CAPTURE_MAX_QUERY_CHARS=500
RETRIEVAL_SOURCE_RANKING_ENABLED=true
RETRIEVAL_RELATIONSHIP_EXPANSION_ENABLED=false
RETRIEVAL_RELATIONSHIP_MIN_CONFIDENCE=0.7
RETRIEVAL_RELATIONSHIP_FANOUT_LIMIT=3
RETRIEVAL_RELATIONSHIP_HOP_DECAY=0.72
RETRIEVAL_RELATIONSHIP_MAX_BONUS=0.05
RETRIEVAL_HINT_RANKING_ENABLED=false
RETRIEVAL_HINT_RANKING_MAX_BONUS=0.06
RETRIEVAL_HINT_REPORT_ENABLED=false
RETRIEVAL_HINT_REPORT_LIMIT=5
RETRIEVAL_HINT_RESCUE_ENABLED=false
RETRIEVAL_HINT_RESCUE_MIN_SCORE=0.8
RETRIEVAL_HINT_RESCUE_LIMIT=3
RETRIEVAL_SECOND_STAGE_RERANKER_ENABLED=false
RETRIEVAL_SECOND_STAGE_RERANKER_PROVIDER=
RETRIEVAL_SECOND_STAGE_RERANKER_CANDIDATE_LIMIT=20
RETRIEVAL_SECOND_STAGE_RERANKER_TIMEOUT_MS=150
RETRIEVAL_SECOND_STAGE_RERANKER_MAX_BONUS=0.08
PALACE_SYNC_HOST_PATH=./docs
PALACE_SYNC_ALLOWED_ROOTS=/mnt/palace-sync,/app
# Exact comma-separated hosts permitted for custom S3-compatible endpoints.
# Leave empty when using AWS S3 without a custom endpoint URL.
PALACE_SYNC_S3_ALLOWED_ENDPOINT_HOSTS=
PALACE_REPO_CHECKOUT_ROOT=/tmp/palaceoftruth/repo-checkouts
PALACE_SYNC_WATCHER_ENABLED=false
PALACE_SYNC_WATCHER_PROBE_SECONDS=10
FEED_POLL_MIN_INTERVAL=300
FEED_MAX_FAILURES=5
SOURCE_RESOURCE_REFRESH_DISPATCH_ENABLED=false
SOURCE_RESOURCE_REFRESH_ALLOWED_HOSTS=
# Exact subset of allowed hosts that may resolve to private addresses.
SOURCE_RESOURCE_REFRESH_TRUSTED_PRIVATE_HOSTS=
SOURCE_SUBSCRIPTION_POLL_MIN_INTERVAL=900
SOURCE_SUBSCRIPTION_MAX_FAILURES=5
SOURCE_SUBSCRIPTION_MANUAL_SYNC_COOLDOWN_SECONDS=300
SOURCE_SUBSCRIPTION_STALE_QUEUED_MINUTES=60

# Optional no-JavaScript social post capture.
# X posts use public server-side metadata without credentials, preferring rich
# article/post JSON and falling back to publish.twitter.com oEmbed.
# Facebook public posts need a Meta app token with the oEmbed Read / Meta oEmbed Read feature.
FACEBOOK_OEMBED_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v25.0

# Optional Firecrawl webpage scraping.
# local keeps the built-in trafilatura/Playwright path. firecrawl-cloud uses
# https://api.firecrawl.dev/v2 and requires FIRECRAWL_API_KEY. firecrawl-self-hosted
# uses FIRECRAWL_BASE_URL and may omit FIRECRAWL_API_KEY when the deployment is
# protected by private networking instead of bearer auth.
WEBPAGE_SCRAPER_PROVIDER=local
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_SECONDS=60
FIRECRAWL_ONLY_MAIN_CONTENT=true

# Optional Hermes Palace memory plugin write guardrails. These are mirrored by
# ~/.hermes/palaceoftruth.json for local Hermes installs.
PALACEOFTRUTH_WRITE_QUOTAS_ENABLED=true
PALACEOFTRUTH_MAX_WRITES_PER_TURN=5
PALACEOFTRUTH_MAX_WRITES_PER_SESSION=100
PALACEOFTRUTH_MAX_BULK_CALLS_PER_TURN=2
PALACEOFTRUTH_DEDUP_CACHE_TTL_SECONDS=300
PALACEOFTRUTH_INCLUDE_TENANT_SHARED=false
# Optional delegated sibling-agent scope patterns. Example: agent/*
PALACEOFTRUTH_INCLUDE_AGENT_SCOPE_PATTERNS=
PALACEOFTRUTH_AGENT_SCOPE_PATTERN_LIMIT=5
PALACEOFTRUTH_INCLUDE_ALL_PERMITTED_AGENT_SCOPES=false
PALACEOFTRUTH_INCLUDE_ALL_PERMITTED_WORKSPACE_SCOPES=false
PALACEOFTRUTH_SEMANTIC_PREFETCH_ENABLED=false
PALACEOFTRUTH_SEMANTIC_PREFETCH_TOP_K=5
PALACEOFTRUTH_SEMANTIC_PREFETCH_CANDIDATE_LIMIT=20
PALACEOFTRUTH_SEMANTIC_PREFETCH_RECALL_MAX_TOKENS=1200
PALACEOFTRUTH_SEMANTIC_PREFETCH_CONTEXT_BUDGET_CHARS=4000
# Optional comma-separated 12-character Hermes cron job IDs. Automatic
# completed-turn capture is skipped for these jobs; explicit memory tools stay enabled.
PALACEOFTRUTH_CRON_AUTOMATIC_CAPTURE_DISABLED_JOB_IDS=
